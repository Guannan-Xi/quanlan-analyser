{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quanlan.example/schemas/simnibs-delivery-v2.schema.json",
  "title": "QuanLan standardized SimNIBS delivery",
  "type": "object",
  "required": [
    "schema_version",
    "analysis_mode",
    "stimulation_modality",
    "project",
    "subject",
    "targets",
    "protocol",
    "results",
    "quality_control",
    "figures",
    "artifacts",
    "modules"
  ],
  "properties": {
    "schema_version": { "const": "simnibs.delivery.v2" },
    "analysis_mode": { "enum": ["forward_single", "forward_compare", "inverse_optimization", "group_analysis"] },
    "stimulation_modality": { "enum": ["tes", "temporal_interference", "tms"] },
    "project": {
      "type": "object",
      "required": ["project_id", "title", "scientific_question", "service_status"],
      "properties": {
        "project_id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "scientific_question": { "type": "string", "minLength": 1 },
        "service_status": { "enum": ["draft", "ready", "blocked"] }
      }
    },
    "subject": {
      "type": "object",
      "required": ["subject_id", "model_type", "image_source"],
      "properties": {
        "subject_id": { "type": "string", "minLength": 1 },
        "model_type": { "type": "string", "minLength": 1 },
        "image_source": { "type": "string", "minLength": 1 }
      }
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["target_id", "name", "role", "definition", "coordinate_space"],
        "properties": {
          "target_id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "role": { "type": "string", "minLength": 1 },
          "definition": { "type": "string", "minLength": 1 },
          "coordinate_space": { "type": "string", "minLength": 1 }
        }
      }
    },
    "protocol": {
      "type": "object",
      "required": ["conditions"],
      "properties": {
        "amplitude_convention": { "type": "string" },
        "conditions": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["condition_id", "label", "channels"],
            "properties": {
              "condition_id": { "type": "string", "minLength": 1 },
              "label": { "type": "string", "minLength": 1 },
              "channels": { "type": "array", "minItems": 1, "items": { "type": "object" } }
            }
          }
        }
      }
    },
    "results": {
      "type": "object",
      "required": ["headline_findings", "metric_definitions", "roi_metrics"],
      "properties": {
        "headline_findings": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "interpretation": { "type": "array", "items": { "type": "string" } },
        "interpretation_boundary": { "type": "string" },
        "metric_definitions": {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "required": ["label", "unit", "definition"],
            "properties": {
              "label": { "type": "string", "minLength": 1 },
              "unit": { "type": "string" },
              "definition": { "type": "string", "minLength": 1 }
              ,"decimals": { "type": "integer", "minimum": 0, "maximum": 12 }
            }
          }
        },
        "roi_metrics": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["condition_id", "target_id", "values"],
            "properties": {
              "condition_id": { "type": "string" },
              "target_id": { "type": "string" },
              "values": { "type": "object", "additionalProperties": { "type": ["number", "string", "null"] } }
            }
          }
        }
      }
    },
    "quality_control": {
      "type": "object",
      "required": ["checks", "limitations"],
      "properties": {
        "checks": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["name", "status"],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "status": { "enum": ["pass", "warning", "fail", "not_assessed"] },
              "evidence": { "type": "string" }
            }
          }
        },
        "limitations": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
      }
    },
    "methods": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title", "text"],
        "properties": { "title": { "type": "string" }, "text": { "type": "string" } }
      }
    },
    "figures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["figure_id", "category", "title", "conclusion", "image", "source_data"],
        "properties": {
          "figure_id": { "type": "string", "minLength": 1 },
          "category": { "enum": ["anatomy", "protocol", "field", "quantitative", "localization", "robustness"] },
          "title": { "type": "string", "minLength": 1 },
          "conclusion": { "type": "string", "minLength": 1 },
          "image": { "type": "string", "minLength": 1 },
          "vector": { "type": "string" },
          "pdf": { "type": "string" },
          "source_data": { "type": "string", "minLength": 1 }
        }
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["path", "label", "purpose"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "label": { "type": "string", "minLength": 1 },
          "purpose": { "type": "string", "minLength": 1 },
          "customer_visible": { "type": "boolean" },
          "generated_by_builder": { "type": "boolean" }
        }
      }
    },
    "modules": {
      "type": "object",
      "properties": {
        "temporal_interference": { "$ref": "#/$defs/temporalInterference" },
        "tes": { "$ref": "#/$defs/tes" },
        "tms": { "$ref": "#/$defs/tms" }
      }
    }
  },
  "$defs": {
    "temporalInterference": {
      "type": "object",
      "required": ["primary_metric", "secondary_metric", "carrier_frequencies_hz", "beat_frequency_hz", "direction_source"]
    },
    "tes": {
      "type": "object",
      "required": ["primary_field", "current_unit", "field_unit"]
    },
    "tms": {
      "type": "object",
      "required": ["coil_model", "field_metric", "field_unit", "coil_pose"]
    }
  }
}
