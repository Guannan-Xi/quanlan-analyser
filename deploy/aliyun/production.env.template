# QLanalyser Production Environment Configuration Template
# Copy this file to production.env and fill in the actual values
# NEVER commit production.env with real secrets to version control

# ============================================
# Application Configuration
# ============================================
APP_ENV=production
APP_DEBUG=false

# Generate a secure random secret key:
# python -c "import secrets; print(secrets.token_urlsafe(32))"
APP_SECRET_KEY=CHANGE_ME_TO_RANDOM_SECRET_KEY

# ============================================
# Service URLs
# ============================================
QLANALYSER_PUBLIC_BASE_URL=https://qlanalyser.online
QLANALYSER_API_BASE_URL=https://qlanalyser.online/api

# ============================================
# CORS Configuration
# ============================================
QLANALYSER_CORS_ORIGINS=https://qlanalyser.online,https://www.qlanalyser.online

# ============================================
# Database Configuration (if using PostgreSQL)
# ============================================
# Uncomment and configure if you add PostgreSQL
# DATABASE_URL=postgresql://qlanalyser:STRONG_PASSWORD@postgres:5432/qlanalyser
# DATABASE_POOL_SIZE=20
# DATABASE_MAX_OVERFLOW=40

# ============================================
# Redis Configuration (if using for caching/queue)
# ============================================
# Uncomment and configure if you add Redis
# REDIS_URL=redis://redis:6379/0
# REDIS_MAX_CONNECTIONS=50

# ============================================
# Aliyun OSS Storage Configuration
# ============================================
QLANALYSER_STORAGE_BACKEND=oss
QLANALYSER_ALIYUN_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com
QLANALYSER_ALIYUN_OSS_BUCKET=qlanalyser-prod-data

# Get from Aliyun RAM console (use dedicated RAM user with minimal permissions)
QLANALYSER_ALIYUN_OSS_ACCESS_KEY_ID=CHANGE_ME_OSS_ACCESS_KEY
QLANALYSER_ALIYUN_OSS_ACCESS_KEY_SECRET=CHANGE_ME_OSS_SECRET_KEY

QLANALYSER_ALIYUN_OSS_ALLOW_WRITE=1
QLANALYSER_ALIYUN_OSS_PREFIX=qlanalyser-v01-production

# OSS Lifecycle Policy (optional)
# QLANALYSER_ALIYUN_OSS_LIFECYCLE_POLICY_EVIDENCE=/app/config/oss_lifecycle_policy.json

# ============================================
# Aliyun OSS Backup Configuration
# ============================================
QLANALYSER_ALIYUN_BACKUP_BUCKET=qlanalyser-prod-backup
QLANALYSER_ALIYUN_BACKUP_PREFIX=qlanalyser-v01-production-backup

# ============================================
# File Storage Configuration
# ============================================
UPLOAD_DIR=/app/uploads
RESULTS_DIR=/app/results
ARTIFACTS_DIR=/app/artifacts
MAX_UPLOAD_SIZE=21474836480  # 20GB in bytes

# ============================================
# Security Configuration
# ============================================
ALLOWED_HOSTS=qlanalyser.online,www.qlanalyser.online

# Session configuration
SESSION_EXPIRE_HOURS=24
JWT_SECRET_KEY=CHANGE_ME_TO_RANDOM_JWT_SECRET
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Rate limiting (if implemented)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# ============================================
# Third-Party Service Configuration
# ============================================

# Payment Provider (Alipay)
QLANALYSER_PAYMENT_PROVIDER_MODE=production
# QLANALYSER_ALIPAY_APP_ID=CHANGE_ME
# QLANALYSER_ALIPAY_PRIVATE_KEY=CHANGE_ME
# QLANALYSER_ALIPAY_PUBLIC_KEY=CHANGE_ME
# QLANALYSER_ALIPAY_CALLBACK_EVIDENCE=/app/config/alipay_callback_production.json

# Payment Provider (WeChat Pay)
# QLANALYSER_WECHAT_PAY_MCHID=CHANGE_ME
# QLANALYSER_WECHAT_PAY_PRIVATE_KEY=CHANGE_ME
# QLANALYSER_WECHAT_PAY_SERIAL_NO=CHANGE_ME
# QLANALYSER_WECHAT_PAY_APIV3_KEY=CHANGE_ME
# QLANALYSER_WECHAT_PAY_CALLBACK_EVIDENCE=/app/config/wechat_pay_callback_production.json

# Email Provider
QLANALYSER_EMAIL_PROVIDER_MODE=production
# QLANALYSER_EMAIL_SMTP_HOST=smtp.aliyun.com
# QLANALYSER_EMAIL_SMTP_PORT=465
# QLANALYSER_EMAIL_SMTP_USER=CHANGE_ME
# QLANALYSER_EMAIL_SMTP_PASSWORD=CHANGE_ME
# QLANALYSER_EMAIL_FROM_ADDRESS=noreply@qlanalyser.online

# SMS Provider (Aliyun SMS)
QLANALYSER_SMS_PROVIDER_MODE=production
# QLANALYSER_ALIYUN_SMS_ACCESS_KEY=CHANGE_ME
# QLANALYSER_ALIYUN_SMS_SECRET_KEY=CHANGE_ME
# QLANALYSER_ALIYUN_SMS_SIGN_NAME=CHANGE_ME
# QLANALYSER_ALIYUN_SMS_TEMPLATE_CODE=CHANGE_ME

# WeChat OAuth
QLANALYSER_WECHAT_AUTH_PROVIDER_MODE=production
# QLANALYSER_WECHAT_APP_ID=CHANGE_ME
# QLANALYSER_WECHAT_APP_SECRET=CHANGE_ME

# ============================================
# Monitoring and Logging
# ============================================

# Sentry Error Tracking
# SENTRY_DSN=https://your-sentry-dsn@sentry.io/project-id
# SENTRY_ENVIRONMENT=production
# SENTRY_TRACES_SAMPLE_RATE=0.1

# Log Level
LOG_LEVEL=INFO
LOG_FORMAT=json

# ============================================
# Performance Configuration
# ============================================

# Uvicorn Workers (adjust based on CPU cores)
UVICORN_WORKERS=4
UVICORN_MAX_REQUESTS=10000
UVICORN_MAX_REQUESTS_JITTER=1000

# ============================================
# Feature Flags
# ============================================
ENABLE_API_DOCS=false  # Set to false to disable /docs and /redoc in production
ENABLE_ADMIN_FEATURES=true
ENABLE_BILLING=true
ENABLE_DEMO_MODE=false

# ============================================
# Backup and Maintenance
# ============================================
BACKUP_ENABLED=true
BACKUP_SCHEDULE="0 2 * * *"  # Daily at 2 AM
BACKUP_RETENTION_DAYS=30
